MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
VISAI_DB=visai

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: model for the reflect step. Falls back to OPENROUTER_MODEL.
OPENROUTER_REFLECT_MODEL=
# Embedding model on OpenRouter used for Atlas Vector Search.
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
VISAI_EMBED_DIM=1536

# Eval (kernel-forge names). Served model endpoint is any OpenAI-compatible server.
VISAI_SERVER_BASE=http://127.0.0.1:8080
EVAL_DATASET=gsm8k
EVAL_N=10
EVAL_SEED=42
EVAL_SHOTS=4

# Optional remote CUDA executor (Modal)
VISAI_REMOTE_EXECUTOR_URL=
